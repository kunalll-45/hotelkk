# =============================================================
# K K's Food House - Environment Configuration
# =============================================================
# Copy this file to .env and update values for your environment.
# DO NOT commit the actual .env file to Git.
# =============================================================

# ---- Server ----
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ---- Public URL (used for QR codes, console logs, etc.) ----
# Change this to your server's public IP or domain name
PUBLIC_IP=15.252.17.218

# ---- CORS ----
# Comma-separated list of allowed origins, or * for all
CORS_ORIGIN=*

# ---- Body Parser Limits ----
BODY_LIMIT=15mb

# ---- AWS S3 Configuration ----
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your_s3_bucket_name
