# =============================================================
# K K's Food House - Environment Configuration
# =============================================================
# Copy this file to .env and update values for your environment.
# DO NOT commit the actual .env file to Git.
# =============================================================

# ---- Server ----
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ---- Public IP or Load Balancer DNS ----
# Set this one option to your public IP or Load Balancer DNS:
PUBLIC_IP=15.252.17.218

# ---- CORS ----
# Comma-separated list of allowed origins, or * for all
CORS_ORIGIN=*

# ---- Body Parser Limits ----
BODY_LIMIT=15mb

# ---- AWS S3 Configuration ----
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your_s3_bucket_name

# S3 Image Processing Prefixes
# S3 object key prefix for uploaded images to trigger Lambda
S3_UPLOAD_PREFIX=new
# S3 object key prefix or naming convention for processed compressed images
S3_PROCESSED_PREFIX=compressed

# ---- Amazon RDS MySQL Database Configuration ----
# Configurable Amazon RDS instance settings
RDS_HOSTNAME=your-rds-mysql-instance.xxxxxx.ap-south-1.rds.amazonaws.com
RDS_PORT=3306
RDS_DB_NAME=kks_food_house
RDS_USERNAME=your_rds_username
RDS_PASSWORD=your_rds_password
RDS_SSL=false
