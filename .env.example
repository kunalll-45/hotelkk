# =============================================================
# K K's Food House - Environment Configuration
# =============================================================
# Copy this file to .env and update values for your environment.
# DO NOT commit the actual .env file to Git.
# =============================================================

# ---- Server ----
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ---- Public URL (used for QR codes, console logs, etc.) ----
# Change this to your server's public IP or domain name
PUBLIC_IP=15.252.17.218

# ---- CORS ----
# Comma-separated list of allowed origins, or * for all
CORS_ORIGIN=*

# ---- Body Parser Limits ----
BODY_LIMIT=15mb
